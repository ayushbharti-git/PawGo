# PawGo Server Configuration
PORT=3000

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas URI)
# For local MongoDB: mongodb://127.0.0.1:27017/pawgo
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pawgo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pawgo

# External API Endpoints
DOG_API_URL=https://dog.ceo/api/breeds/image/random
CAT_FACTS_API_URL=https://catfact.ninja/fact

